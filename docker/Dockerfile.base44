# Development image for the Base44 sandbox (see AGENTS.md).
#
# Plain runtime image only: bun, uv and Python 3.12, no application source.
# The checkout is bind-mounted at /app by docker-compose.base44.yml and
# docker/base44-dev-start.sh installs dependencies and starts the live-reload
# dev servers (Vite + uvicorn --reload) at container start.
FROM python:3.12-slim-trixie

COPY --from=oven/bun:1.4.0-slim /usr/local/bin/bun /usr/local/bin/bun
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/

# git: agent nodes that work in git worktrees. curl: manual debugging.
RUN ln -s /usr/local/bin/bun /usr/local/bin/node \
    && apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
